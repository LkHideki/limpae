{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limpae",
  "version": "0.2.0",
  "identifier": "br.com.limpae",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Limpae",
        "width": 1040,
        "height": 700,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#071226"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Disk cleaner for macOS",
    "longDescription": "Finds and removes system junk, large files, Trash items and leftovers from uninstalled apps.",
    "copyright": "Released into the public domain (The Unlicense)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "locales/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "locales/pt-BR.lproj/InfoPlist.strings": "pt-BR.lproj/InfoPlist.strings",
      "locales/id.lproj/InfoPlist.strings": "id.lproj/InfoPlist.strings"
    }
  }
}
