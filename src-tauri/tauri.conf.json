{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limpaemeo",
  "version": "0.1.0",
  "identifier": "br.com.limpaemeo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Limpaemeo",
        "width": 1040,
        "height": 700,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#071226"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "shortDescription": "Limpeza de disco para macOS",
    "longDescription": "Encontra e remove lixo do sistema, arquivos grandes, itens da Lixeira e restos de apps desinstalados.",
    "copyright": "Copyright © 2026 Limpaemeo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
